{
  "name": "zeroad.network/token",
  "description": "Offline verification of Zero Ad Network subscriber tokens for publisher backends. No dependencies beyond ext-sodium.",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "zero-ad-network",
    "zeroad",
    "zero-ad",
    "better-web",
    "publisher",
    "monetization",
    "ad-free",
    "paywall",
    "subscription",
    "membership",
    "entitlement",
    "content-access",
    "sdk",
    "token",
    "token-verification",
    "verify",
    "signature",
    "http-header",
    "offline-verification",
    "ed25519",
    "eddsa",
    "sodium",
    "libsodium",
    "privacy",
    "hostname-binding",
    "middleware",
    "laravel",
    "symfony",
    "slim",
    "wordpress",
    "serverless",
    "bref",
    "aws",
    "aws-lambda",
    "google-cloud",
    "google-cloud-functions",
    "cloud-run"
  ],
  "homepage": "http://zeroad.network",
  "authors": [
    {
      "name": "Laurynas Karvelis <Explosive Brains Ltd>",
      "email": "hello@zeroad.network",
      "homepage": "http://zeroad.network",
      "role": "Developer"
    }
  ],
  "scripts": {
    "test": "./vendor/bin/phpunit --testdox --bootstrap vendor/autoload.php tests"
  },
  "require": {
    "php": "^7.2 || ^8.0",
    "ext-sodium": "*"
  },
  "suggest": {
    "ext-apcu": "For improved caching performance using APCu"
  },
  "require-dev": {
    "phpunit/phpunit": "8.5.52"
  },
  "config": {
    "platform": {
      "php": "7.2.34"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "ZeroAd\\Token\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ZeroAd\\Token\\Tests\\": "tests/"
    }
  }
}
